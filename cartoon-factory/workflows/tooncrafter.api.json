{
  "_comment": {
    "class_type": "Note",
    "_meta": {"title": "⚠️ À VÉRIFIER : noms des nœuds ComfyUI-ToonCrafter (AIGODLIKE). Exporter le workflow d'exemple du dépôt au format API et reporter les placeholders. Voir workflows/README.md."},
    "inputs": {}
  },
  "1": {
    "class_type": "LoadImage",
    "_meta": {"title": "Dessin clé de départ"},
    "inputs": {"image": "__IMAGE_START__", "upload": "image"}
  },
  "2": {
    "class_type": "LoadImage",
    "_meta": {"title": "Dessin clé d'arrivée"},
    "inputs": {"image": "__IMAGE_END__", "upload": "image"}
  },
  "3": {
    "class_type": "ImageScale",
    "_meta": {"title": "Redim. départ 512x320"},
    "inputs": {"upscale_method": "lanczos", "width": "__WIDTH__", "height": "__HEIGHT__",
               "crop": "center", "image": ["1", 0]}
  },
  "4": {
    "class_type": "ImageScale",
    "_meta": {"title": "Redim. arrivée 512x320"},
    "inputs": {"upscale_method": "lanczos", "width": "__WIDTH__", "height": "__HEIGHT__",
               "crop": "center", "image": ["2", 0]}
  },
  "5": {
    "class_type": "ToonCrafterNode",
    "_meta": {"title": "ToonCrafter (interpolation)"},
    "inputs": {
      "ckpt_name": "__TOONCRAFTER__",
      "image": ["3", 0],
      "image2": ["4", 0],
      "prompt": "__PROMPT__",
      "steps": "__STEPS__",
      "cfg_scale": "__CFG__",
      "eta": "__ETA__",
      "frame_count": "__FRAMES__",
      "fps": "__FPS__",
      "seed": "__SEED__",
      "fp8_unet": true
    }
  },
  "6": {
    "class_type": "VHS_VideoCombine",
    "_meta": {"title": "Export MP4 (VideoHelperSuite)"},
    "inputs": {
      "frame_rate": "__FPS__",
      "loop_count": 0,
      "filename_prefix": "__PREFIX__",
      "format": "video/h264-mp4",
      "pix_fmt": "yuv420p",
      "crf": 17,
      "save_metadata": false,
      "pingpong": false,
      "save_output": true,
      "images": ["5", 0]
    }
  }
}
