{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": {"title": "Checkpoint SDXL"},
    "inputs": {"ckpt_name": "__SDXL_CHECKPOINT__"}
  },
  "2": {
    "class_type": "LoraLoader",
    "_meta": {"title": "LoRA style crayon (retiré si vide)"},
    "inputs": {
      "lora_name": "__STYLE_LORA__",
      "strength_model": "__STYLE_LORA_WEIGHT__",
      "strength_clip": "__STYLE_LORA_WEIGHT__",
      "model": ["1", 0],
      "clip": ["1", 1]
    }
  },
  "3": {
    "class_type": "LoraLoader",
    "_meta": {"title": "LoRA personnage (retiré si vide)"},
    "inputs": {
      "lora_name": "__CHAR_LORA__",
      "strength_model": "__CHAR_LORA_WEIGHT__",
      "strength_clip": "__CHAR_LORA_WEIGHT__",
      "model": ["2", 0],
      "clip": ["2", 1]
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Prompt positif"},
    "inputs": {"text": "__PROMPT__", "clip": ["3", 1]}
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Prompt négatif"},
    "inputs": {"text": "__NEGATIVE__", "clip": ["3", 1]}
  },
  "6": {
    "class_type": "EmptyLatentImage",
    "_meta": {"title": "Latent vide"},
    "inputs": {"width": "__WIDTH__", "height": "__HEIGHT__", "batch_size": 1}
  },
  "7": {
    "class_type": "KSampler",
    "_meta": {"title": "KSampler"},
    "inputs": {
      "seed": "__SEED__",
      "steps": "__STEPS__",
      "cfg": "__CFG__",
      "sampler_name": "__SAMPLER__",
      "scheduler": "__SCHEDULER__",
      "denoise": 1.0,
      "model": ["3", 0],
      "positive": ["4", 0],
      "negative": ["5", 0],
      "latent_image": ["6", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "_meta": {"title": "Décodage VAE"},
    "inputs": {"samples": ["7", 0], "vae": ["1", 2]}
  },
  "9": {
    "class_type": "SaveImage",
    "_meta": {"title": "Sauvegarde"},
    "inputs": {"filename_prefix": "__PREFIX__", "images": ["8", 0]}
  }
}
